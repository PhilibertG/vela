{
  "name": "vela",
  "version": "0.2.0",
  "private": true,
  "description": "Vela - navigateur Chromium avec barre latérale, Spaces et barre de commande",
  "main": "out/main/index.js",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "5.9",
    "vite": "^7.3.6"
  },
  "author": "PhilibertG",
  "desktopName": "vela.desktop"
}
